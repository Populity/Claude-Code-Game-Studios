# VSV API — Node 22 built-ins only, no npm install needed.
FROM node:22-alpine
RUN addgroup -S vsv && adduser -S vsv -G vsv && mkdir -p /data && chown vsv:vsv /data
WORKDIR /srv
COPY packages/core packages/core
COPY packages/security packages/security
COPY apps/server apps/server
USER vsv
ENV DATA_DIR=/data PORT=8080 TRUST_PROXY=1 NODE_ENV=production
EXPOSE 8080
HEALTHCHECK CMD wget -qO- http://127.0.0.1:8080/api/healthz || exit 1
CMD ["node", "--disable-warning=ExperimentalWarning", "apps/server/src/main.ts"]
